{
  "name": "mini-midgard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 4200",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4201",
    "typecheck": "tsc --noEmit",
    "sim": "taskpolicy -b node --experimental-strip-types tools/sim.ts",
    "party-check": "taskpolicy -b node --experimental-strip-types tools/party-check.ts",
    "build-check": "taskpolicy -b node --experimental-strip-types tools/build-check.ts",
    "expedition-check": "taskpolicy -b node --experimental-strip-types tools/expedition-check.ts",
    "rift-check": "taskpolicy -b node --experimental-strip-types tools/rift-check.ts",
    "rift-flow": "taskpolicy -b node --experimental-strip-types tools/rift-flow.ts",
    "asset:records": "node tools/asset-kit-pixel.mjs && node tools/asset-kit-sprites.mjs --root . --in src/assets/sprites/manifest.json --out asset-records/hero-sprites/manifest.json",
    "asset:check": "node ../asset-kit/tools/check.mjs --root .",
    "asset:workshop": "npm run asset:records && vite build && node ../asset-kit/tools/serve.mjs --root .",
    "timelines": "node tools/register-timelines.mjs"
  },
  "dependencies": {
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^26.6.4",
    "galmuri": "^2.40.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
