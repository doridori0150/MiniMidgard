  "renderRules": {
    "attachment": "parent matrix * translate(parent anchor - parent pivot + offset) * rotate(angle) * scale; draw at -pivot",
    "worldAngle": "absolute canvas-space rotation, preserving transformed grip position and inherited scale; apply facing mirror afterward",
    "sorting": "ascending part.z then node id; optional node.z overrides",
    "interpolation": "linear numeric fields; missing fields resolve to rest node; slot and visible step at key time",
    "tint": "multiply RGB on hair_front/hair_back only, restore original alpha",
    "facing": "mirror entire character around canvas.origin.x, including attachments",
    "nonLoop": "clamp at duration",
    "missingAsset": "error for unknown non-null slot value; null equipment skips node"
  }
