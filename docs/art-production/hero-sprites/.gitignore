# Keep the requested fix1 evidence reviewable; omit intermediate animation PNGs.
!/source/
source/*
!source/fix1/
source/fix1/*
!source/fix1/*-attempt*.png
!source/fix1/*-targets.png
!source/fix1/annotations.json
!source/fix1/game-manifest-before.json
!source/fix1/imported/
!/verification/
verification/*
!verification/review_*.png
!verification/checks.json
!verification/check-unscoped-spec.json
!verification/check-fix1.log
!verification/anchor-checks.png
!verification/hair-tints.png
!verification/fix1-build.log

# fix2 source, exact prompt inputs, coordinates and preservation audit.
!source/fix2/
source/fix2/*
!source/fix2/archer-attempt1.png
!source/fix2/*.json

# fix3 whole-body sources, inputs, coordinate evidence and audit.
!source/fix3/
source/fix3/*
!source/fix3/*-attempt*.png
!source/fix3/*-reference.png
!source/fix3/*.json
!verification/fix3-*.png
!verification/fix3-*.json
!verification/check-fix3.log

# Batch B accepted axe and rejected candidate evidence.
!source/b/
!source/b/**
!verification/b-*
verification/b-animation-frames/
!verification/check-b.log

# fix4 adopted candidate processing, preservation audit and final visual evidence.
!source/fix4/
!source/fix4/**
!verification/fix4-*.png
!verification/fix4-*.json
!verification/fix4-*.txt
